<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the NSIS installer, built around the already
  signed trimcraft.exe. The release workflow uploads it as a GitHub artifact, which is a zip with
  the file at its root. Product name and version are enforced; the workflow passes the version.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Trimcraft_${version}_x64-setup.exe" product-name="Trimcraft" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
