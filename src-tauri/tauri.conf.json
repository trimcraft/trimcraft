{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trimcraft",
  "version": "0.1.2",
  "identifier": "cloud.breu.trimcraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trimcraft",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0OTQ3NUY3NjU0RDY0MjUKUldRbFpFMWw5M1dVbExFbE0wVDN6NG1aeTZjaUgzZkcweGt0ZTN4TEdYaDRZRGtDUjhQcy9reWMK",
      "endpoints": [
        "https://github.com/trimcraft/trimcraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
